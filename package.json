{
  "name": "moji-diary",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:api dev:web",
    "dev:api": "bun --watch server.ts",
    "dev:web": "vite --host 127.0.0.1 --port 4173",
    "build": "vite build",
    "start": "bun server.ts --prod"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "latest",
    "@tailwindcss/vite": "latest",
    "elysia": "latest",
    "gray-matter": "latest",
    "lucide-vue-next": "latest",
    "markdown-it": "latest",
    "tailwindcss": "latest",
    "vite": "latest",
    "vue": "latest"
  }
}
